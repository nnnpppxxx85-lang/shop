DB_USER=root
DB_PASSWORD=12345
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dragon
ADDR=127.0.0.1:8080
ADMIN_TOKEN=dragon-admin-2026

# Публичный адрес сайта — используется реферальным ботом для ссылок вида
# SITE_URL/?ref=<telegram_id партнёра>. На проде укажите домен с https://
SITE_URL=http://127.0.0.1:8080

# Токены ботов из @BotFather. Пока не заполнены — боты просто не запускаются,
# сайт работает как обычно.
REF_BOT_TOKEN=
ADMIN_BOT_TOKEN=

# Код доступа для менеджеров: в админ-боте нужно отправить "/start <код>",
# чтобы начать получать уведомления о заказах и сообщениях с сайта.
ADMIN_BOT_SECRET=dragon-managers-2026
